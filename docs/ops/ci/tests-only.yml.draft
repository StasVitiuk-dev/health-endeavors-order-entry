# DRAFT — NOT ACTIVE. GitHub only runs workflows stored in .github/workflows/.
# To activate (owner approval required): copy this file to
# .github/workflows/tests.yml in its own reviewed PR. A ready branch with
# exactly that one file is described in docs/ops/ci/README.md.
#
# What it does: runs the dashboard's local Playwright tests (synthetic data,
# mocked Supabase) on every pull request to main, and on demand.
# What it can NOT do: it has no secrets, read-only repository access, no
# deployment step, and never contacts Supabase, Shopify or the live site
# (the test mock blocks every outside request and fails the test if one is
# tried; tests/specs/safety.spec.js and no-live-send.spec.js check this).
name: Dashboard tests (tests only, no deploy)

on:
  pull_request:
    branches: [main]
  workflow_dispatch:

# Least privilege: every job can read the code and nothing else.
permissions:
  contents: read

concurrency:
  group: tests-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # The check to make required. Screenshot comparisons are skipped here
  # (--ignore-snapshots) because font rendering on GitHub's runners can differ
  # from the machine that recorded the baselines; behaviour is what's gated.
  playwright:
    name: Playwright (behaviour)
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      # Actions pinned to exact commits (supply-chain safety, like R7).
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: 22
          cache: npm
      - name: Install exact test dependencies (package-lock, no install scripts)
        run: npm ci --ignore-scripts
      - name: Install the test browser (version fixed by package-lock)
        run: npx playwright install --with-deps chromium
      - name: Run tests
        run: npx playwright test --config tests/playwright.config.js --ignore-snapshots --reporter=list,github
      # Synthetic data only: screenshots and traces of the mocked dashboard.
      # The traces contain the page's public anon key (already public in the
      # HTML) and nothing else that is secret.
      - name: Keep failure screenshots and traces (7 days)
        if: failure()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: playwright-results
          path: test-results/
          retention-days: 7

  # Informational: pixel comparisons. Never blocks a merge until the owner
  # decides the baselines are stable on GitHub's runners.
  visual:
    name: Screenshots (informational)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    continue-on-error: true
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: 22
          cache: npm
      - run: npm ci --ignore-scripts
      - run: npx playwright install --with-deps chromium
      - name: Compare screenshots
        run: npx playwright test --config tests/playwright.config.js tests/specs/visual.spec.js --reporter=list,github
      - name: Keep the differences (7 days)
        if: failure()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: screenshot-differences
          path: test-results/
          retention-days: 7
